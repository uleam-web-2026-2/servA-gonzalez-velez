# Copie este archivo a .env y reemplace los valores de ejemplo por los de su máquina.
# .env está ignorado por Git; este archivo sí es seguro para subir.

# Conexión a PostgreSQL. Reemplace CAMBIE_ESTO por la contraseña local de la base.
DATABASE_URL=host=localhost user=postgres password=CAMBIE_ESTO dbname=rentcar port=5433 sslmode=disable

# Configuración del servidor.
PUERTO=8080
TIEMPO_ESPERA_SEGUNDOS=5

# Clave de firma JWT: reemplácela por un valor aleatorio de al menos 32 caracteres.
CLAVE_FIRMA=CAMBIE_ESTO_POR_UNA_CLAVE_ALEATORIA_DE_32_CARACTERES_O_MAS

# Credenciales ficticias de las cuentas de prueba sembradas para la colección Bruno.
# Cambie estos valores junto con las claves usadas en docs/hito2_bruno.
CLAVE_ANA=ana-2026
CLAVE_LUIS=luis-2026

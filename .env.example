# .env.example — copie este archivo a .env y complete los valores de SU máquina.
# .env no se sube al repositorio (está en .gitignore); este archivo sí.

# Secreto: conexión de la API con el usuario de mínimo privilegio (sin permisos de esquema).
DATABASE_URL=host=localhost user=rentcar_api password=CAMBIE_ESTA_CLAVE_API dbname=rentcar port=5433

# Secreto: conexión exclusiva para migraciones y siembra (-migrar). Usa el dueño de las tablas.
DATABASE_URL_MIGRACION=host=localhost user=postgres password=CAMBIE_ESTA_CLAVE_ADMIN dbname=rentcar port=5433

# Usuario y contraseña de mínimo privilegio que usa la API (y crea el servicio migrador en Compose).
DB_API_USER=rentcar_api
DB_API_PASSWORD=CAMBIE_ESTA_CLAVE_API

# Contraseña del usuario administrador de PostgreSQL (usada por Docker Compose).
POSTGRES_PASSWORD=CAMBIE_ESTA_CLAVE_ADMIN

# Configuración: cambia por máquina. Si se omite, el servidor usa 8080.
PUERTO=8080

# Configuración: cuántos segundos espera el servidor antes de cortar. Si se omite, 5.
TIEMPO_ESPERA_SEGUNDOS=5

# Secreto: firma los tokens JWT. Debe ser un texto largo y al azar (32 letras/números o más). Sin valor por defecto.
CLAVE_FIRMA=CAMBIE_ESTO_POR_UNA_CLAVE_DE_32_LETRAS_Y_NUMEROS_O_MAS
